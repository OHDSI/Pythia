node_modules/
dist/
*.log
.DS_Store
coverage/

# Generated by trex-init on first boot — crypto/JWT keys, never commit.
/secrets/
# Local secrets (Bedrock token, passwords).
.env
# Locally rebuilt WebAPI native lib (large arch-specific binary; built from ../trex).
/native-libs/
/frontend-assets/
# Local agent / browser-automation artifacts. Screenshots taken while driving
# the UI land in the repo root; three of them reached main once already.
/.claude/
/.playwright-mcp/
/atlas-*.png
/pythia-*.png
/*-baseline.png
docs/superpowers/

.worktrees/
.gstack/

# Demo recordings. The mp4/webm are large (25-35 MB per take) and would live in
# git history forever: upload the mp4 as a GitHub release attachment and let the
# README link that URL. Only the poster stills belong in figures/.
figures/*.mp4
figures/*.webm
figures/*.gif

# TrexSQL per-source cache (bind-mounted into trex; rebuilt on demand)
/trexsql-cache/
