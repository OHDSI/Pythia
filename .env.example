# Copy to .env and fill in.

# Postgres superuser password for the bundled Atlas3 database / trex metadata.
POSTGRES_PASSWORD=mypass

# Bedrock long-term API key consumed by the bao plugin (the Pythia backend).
# Required for Pythia to answer.
#   aws iam create-service-specific-credential \
#     --user-name <iam-user> --service-name bedrock.amazonaws.com
AWS_BEARER_TOKEN_BEDROCK=

# Which model Pythia runs on. BAO_AGENT_MODEL is a Bedrock model id;
# BAO_AGENT_MODEL_SPEC is a full provider/model spec and wins when both are set.
BAO_AGENT_MODEL=minimax.minimax-m2.5
# BAO_AGENT_MODEL_SPEC=bedrock/us.anthropic.claude-sonnet-4-6
# BAO_AGENT_MODEL_SPEC=openai/openai.gpt-5.6-terra

# Region used to build the default OpenAI-compatible Bedrock endpoint, and the
# endpoint itself if you need to point somewhere other than bedrock-mantle.
# AWS_REGION=us-east-1
# OPENAI_BASE_URL=

# Image overrides. Both default to a pinned build in docker-compose.yml: a
# published ATLAS image and a trexsql digest. Set these to test another build.
# ATLAS_IMAGE=ghcr.io/ohdsi/atlas3:sha-75a31d9
# TREX_IMAGE=

# Surfaces the Pythia FAB + chat panel in the frontend. BUILD-TIME only:
# changing this requires rebuilding the frontend.
VITE_BAO_AGENT_ENABLED=true

# Serving the stack on a hostname other than localhost (e.g. a shared dev box).
# CADDY_TLS_DIRECTIVE becomes a real certificate directive when you have one;
# the default issues a self-signed cert.
# CADDY_HOSTNAME=localhost
# CADDY_TLS_DIRECTIVE=tls internal
# WEBAPI_URL=https://localhost/WebAPI
