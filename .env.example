# Copy to .env and fill in. Consumed by docker-compose.yml.

# Postgres superuser password for the bundled Atlas3 database.
POSTGRES_PASSWORD=mypass

# Bedrock long-term API key consumed by the bao plugin (the Pythia
# backend baked into the WebAPI image). Required for Pythia to answer.
#   aws iam create-service-specific-credential \
#     --user-name <iam-user> --service-name bedrock.amazonaws.com
AWS_BEARER_TOKEN_BEDROCK=

# Optional: which Bedrock model bao uses. Defaults to minimax.minimax-m2.5.
#BAO_AGENT_MODEL=minimax.minimax-m2.5
