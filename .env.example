# Copy to .env and fill in.

# Postgres superuser password for the bundled Atlas3 database / trex metadata.
POSTGRES_PASSWORD=mypass

# Bedrock long-term API key consumed by the bao plugin (the Pythia backend).
# Required for Pythia to answer.
#   aws iam create-service-specific-credential \
#     --user-name <iam-user> --service-name bedrock.amazonaws.com
AWS_BEARER_TOKEN_BEDROCK=

# Which Bedrock model bao uses.
BAO_AGENT_MODEL=minimax.minimax-m2.5

# Surfaces the Pythia FAB + chat panel in the frontend. BUILD-TIME only:
# changing this requires rebuilding the frontend.
VITE_BAO_AGENT_ENABLED=true
