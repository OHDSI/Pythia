{
  "name": "@ohdsi/pythia-agent",
  "version": "0.0.1",
  "description": "Pythia cohort design agent — trex Deno function plugin, served at /agent (via /WebAPI/trexsql/agent or /d2e/agent)",
  "files": [
    "functions",
    "package.json"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OHDSI/trex-dx.git",
    "directory": "agent/plugin"
  },
  "trex": {
    "functions": {
      "env": {
        "_shared": {
          "AWS_REGION": "${AWS_REGION}",
          "AWS_BEARER_TOKEN_BEDROCK": "${AWS_BEARER_TOKEN_BEDROCK}",
          "BAO_AGENT_MODEL": "${BAO_AGENT_MODEL}",
          "BAO_AGENT_WEBAPI_URL": "${BAO_AGENT_WEBAPI_URL}"
        }
      },
      "api": [
        {
          "source": "/agent",
          "function": "/functions",
          "imports": "/functions/deno.json"
        }
      ]
    }
  }
}
