{
  "name": "@ohdsi/pythia-agent",
  "version": "0.1.0",
  "description": "Pythia cohort design agent — trex agents-plugin (eve-layout), mounted at /plugins/ohdsi/pythia",
  "files": [
    "agent",
    "evals",
    "package.json"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OHDSI/trex-dx.git",
    "directory": "agent/plugin"
  },
  "trex": {
    "agents": [
      {
        "name": "pythia",
        "dir": "agent",
        "env": {
          "BAO_AGENT_WEBAPI_URL": "${BAO_AGENT_WEBAPI_URL:-http://localhost:8080/WebAPI}"
        }
      }
    ]
  }
}
