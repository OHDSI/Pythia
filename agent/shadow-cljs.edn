{:source-paths ["src" "test" "resources"]
 :dependencies [[org.clojure/clojurescript "1.11.132"]]
 :builds
 {:fn
  {:target :esm
   :output-dir "out"
   :modules {:tools {:exports {tools pythia.agent-tools/tools
                                instructions pythia.prompt/base-prompt}}}
   :js-options {:js-provider :import
                :keep-as-import #{"eve/tools"}}
   :compiler-options {:infer-externs :auto}}
  :test
  {:target :node-test
   :output-to "out/test.cjs"
   :ns-regexp "-test$"
   :js-options {:resolve {"eve/tools" {:target :file :file "test/eve_tools_stub.mjs"}}}}}}
