# Overlay a locally-rebuilt libwebapi-native.so onto the pinned trex image.
# The published image keeps the GraalVM lib at /usr/lib/libwebapi-native.so
# (the webapi.trex shim dlopens it by that path), so replacing the file in a
# thin derived layer is enough — no full image rebuild, no ldconfig (path and
# soname are unchanged). Build context must contain libwebapi-native.so.
#
#   docker build -f Dockerfile.webapi-native-overlay \
#     --build-arg TREX_IMAGE=ghcr.io/ohdsi/trexsql@sha256:<pinned> \
#     -t ghcr.io/ohdsi/trexsql:bao-native-fix .
ARG TREX_IMAGE
FROM ${TREX_IMAGE}
COPY libwebapi-native.so /usr/lib/libwebapi-native.so
